# ============================================================
# G1-Autopilot AI — Environment Variables
# ============================================================
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any file containing real secrets.
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
# Public base URL of this app (no trailing slash).
# Local dev: http://localhost:3000
# Production: the Vercel deployment URL, e.g. https://app.g1autopilot.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Runtime environment: development | preview | production
NEXT_PUBLIC_APP_ENV=development

# ------------------------------------------------------------
# G1-ID integration (external identity provider)
# ------------------------------------------------------------
# Public base URL of G1-ID. Used for "Register on G1-ID" links
# and, later, for token verification once G1-ID ships its API.
# Per the G1-ID handoff (v1.0), the live URL is:
#   https://g1-id.vercel.app
NEXT_PUBLIC_G1ID_URL=https://g1-id.vercel.app

# Path within G1-ID for signup redirects. Default: /signup
NEXT_PUBLIC_G1ID_SIGNUP_PATH=/signup

# Path within G1-ID for login redirects. Default: /signin
NEXT_PUBLIC_G1ID_SIGNIN_PATH=/signin

# ------------------------------------------------------------
# Database — Supabase (Autopilot's OWN project, NOT G1-ID's)
# ------------------------------------------------------------
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key — safe for client bundle, protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVER ONLY. Never expose to the browser.
# Leave blank until Phase 2 actually needs it.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# AI providers (Phase 6+) — leave blank until configured
# ------------------------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# ------------------------------------------------------------
# Search providers (Phase 4+) — leave blank until configured
# ------------------------------------------------------------
# SEARCH_PROVIDER_API_KEY=

# ------------------------------------------------------------
# Payments (Phase 13+) — leave blank until configured
# ------------------------------------------------------------
# PAYMENT_PROVIDER_SECRET_KEY=
# PAYMENT_PROVIDER_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
# Minimum log level: debug | info | warn | error
LOG_LEVEL=info